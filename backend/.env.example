# ---------------------------------------------------------------------------
# YouTube Transcript Studio — backend configuration
# Copy to `.env` and adjust. Every value has a safe default.
# ---------------------------------------------------------------------------

# Comma-separated list of exact origins allowed to call the API (the Next.js app).
# No trailing slash. "*" is ignored on purpose.
# Production example: CORS_ORIGINS=https://youtube-transcript-studio.vercel.app
CORS_ORIGINS=http://localhost:3000

# Optional regex for additional origins, e.g. this project's Vercel preview URLs:
# CORS_ORIGIN_REGEX=^https://youtube-transcript-studio-[a-z0-9]+-your-team\.vercel\.app$
CORS_ORIGIN_REGEX=

# Optional YouTube Data API v3 key. Improves metadata (duration, live status,
# scheduled start). Without it the backend reads public watch-page metadata
# and falls back to oEmbed. Never expose this key to the frontend.
YOUTUBE_API_KEY=

# Optional proxy for caption requests (YouTube often blocks cloud-provider IPs).
# Example: http://user:pass@proxy.example.com:8080
CAPTIONS_PROXY_HTTP=
CAPTIONS_PROXY_HTTPS=

# ---------------- Speech-to-text (optional) ----------------
# Requires `pip install -r requirements-stt.txt`.
STT_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_CONCURRENT_STT_JOBS=1

# Downloading audio from YouTube is OFF by default. Only enable it if you have
# the rights/permission to process the media you submit (e.g. your own channel,
# licensed content) and it complies with YouTube's Terms of Service in your use.
# Requires yt-dlp + FFmpeg.
ENABLE_YOUTUBE_AUDIO_INGESTION=false
FFMPEG_PATH=ffmpeg

# Limits
MAX_AUDIO_DURATION_SECONDS=10800
MAX_UPLOAD_MB=500
MAX_TXT_CONVERT_MB=20

# ---------------- Live sessions ----------------
LIVE_MAX_SESSIONS=2
LIVE_MAX_SESSION_SECONDS=14400
LIVE_CHUNK_SECONDS=15
LIVE_CAPTION_POLL_SECONDS=20

# ---------------- Jobs / storage ----------------
# Transcripts are kept in memory only and deleted after this many seconds.
JOB_TTL_SECONDS=3600
MAX_JOBS=500

# ---------------- Rate limiting (per client IP) ----------------
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_JOB_CREATE_PER_MINUTE=6
# Set to true only when running behind a trusted reverse proxy (true on Render).
TRUST_PROXY_HEADERS=false
